pragma language_version >= 0.23;

import CompactStandardLibrary;

/**
 * Token Vault — UTXO-Layer Shielded Token Contract
 *
 * Demonstrates real token transfers using the UTXO model.
 * Tokens are received and sent via receiveShielded/sendShielded,
 * meaning they live on the UTXO ledger, not inside contract state.
 *
 * The contract tracks deposit count for observability, but the
 * actual token balances are managed by the UTXO layer.
 */

// The owner's public key, set at deploy time
export ledger owner: Bytes<32>;

// Counter tracking how many deposits have been made
export ledger depositCount: Counter;

// Counter tracking total withdrawals
export ledger withdrawalCount: Counter;

/**
 * Constructor: captures the deployer's public key as the owner.
 */
constructor() {
    owner = disclose(ownPublicKey);
}

/**
 * Deposit shielded tokens into the vault.
 *
 * Anyone can call this. The wallet attaches a shielded coin
 * to the transaction, and receiveShielded() proves the coin
 * is valid and locks it to this contract.
 *
 * The tokens do NOT appear in contract state — they live on
 * the UTXO ledger, locked to the contract's address.
 */
export circuit deposit(): [] {
    receiveShielded();
    depositCount.increment();
}

/**
 * Withdraw shielded tokens from the vault.
 *
 * Only the owner can call this. The contract creates a new
 * UTXO output locked to the owner's address, effectively
 * releasing the tokens back to the owner's wallet.
 *
 * @param amount - The amount to withdraw
 * @param color  - The token type/color to withdraw
 */
export circuit withdraw(amount: Uint<64>, color: Bytes<32>): [] {
    assert(disclose(ownPublicKey) == owner, "only owner can withdraw");
    sendShielded(amount, color, owner);
    withdrawalCount.increment();
}

/**
 * Read-only: get the number of deposits made.
 * Useful for off-chain monitoring.
 */
export circuit getDepositCount(): Uint<64> {
    return depositCount.read();
}

/**
 * Read-only: get the number of withdrawals made.
 */
export circuit getWithdrawalCount(): Uint<64> {
    return withdrawalCount.read();
}
