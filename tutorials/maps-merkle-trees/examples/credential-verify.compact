import CompactStandardLibrary;

// ============================================================
// Credential Verification using Maps and Merkle Trees
// Demonstrates: Credential issuance, revocation checking,
//               proof-based verification without revealing data
// ============================================================

struct Credential {
    holder: Bytes<32>;
    credential_type: Bytes<16>;
    issued_at: Uint<64>;
    expires_at: Uint<64>;
    metadata: Bytes<128>;
}

contract CredentialVerifier() {
    // Credential storage
    ledger credential_tree: MerkleTree<16>;
    ledger credentials: Map<Bytes<32>, Credential>;
    ledger credential_exists: Map<Bytes<32>, Boolean>;
    ledger revoked: Map<Bytes<32>, Boolean>;

    // Issuer management
    ledger issuers: Map<Bytes<32>, Boolean>;
    ledger admin: Bytes<32>;
    ledger current_time: Uint<64>;
    ledger credential_count: Uint<32>;

    // ---- Issuer Management ----

    circuit add_issuer(issuer_id: Bytes<32>, caller: Bytes<32>): Boolean {
        require(caller == admin);
        require(!issuers[issuer_id]);
        issuers[issuer_id] = true;
        return true;
    }

    circuit remove_issuer(issuer_id: Bytes<32>, caller: Bytes<32>): Boolean {
        require(caller == admin);
        require(issuers[issuer_id]);
        issuers[issuer_id] = false;
        return true;
    }

    circuit is_valid_issuer(issuer_id: Bytes<32>): Boolean {
        return issuers[issuer_id];
    }

    // ---- Credential Issuance ----

    circuit issue_credential(
        credential_id: Bytes<32>,
        cred: Credential,
        issuer_id: Bytes<32>
    ): Boolean {
        require(issuers[issuer_id]);
        require(!credential_exists[credential_id]);
        require(cred.issued_at <= current_time);
        require(cred.expires_at > current_time);

        credentials[credential_id] = cred;
        credential_exists[credential_id] = true;

        let commitment: Bytes<32> = hash(
            credential_id ++
            cred.holder ++
            cred.credential_type ++
            field(cred.issued_at) ++
            field(cred.expires_at)
        );
        credential_tree.insert(commitment);
        credential_count = credential_count + 1;
        return true;
    }

    // ---- Credential Revocation ----

    circuit revoke_credential(credential_id: Bytes<32>, issuer_id: Bytes<32>): Boolean {
        require(issuers[issuer_id]);
        require(credential_exists[credential_id]);
        require(!revoked[credential_id]);
        revoked[credential_id] = true;
        return true;
    }

    circuit is_revoked(credential_id: Bytes<32>): Boolean {
        return revoked[credential_id];
    }

    // ---- Credential Verification ----

    circuit verify_credential(
        credential_id: Bytes<32>,
        proof_path: Vector<16, Bytes<32>>,
        proof_directions: Vector<16, Boolean>
    ): Boolean {
        if (!credential_exists[credential_id]) { return false; }
        if (revoked[credential_id]) { return false; }

        let cred: Credential = credentials[credential_id];
        if (cred.expires_at <= current_time) { return false; }

        let commitment: Bytes<32> = hash(
            credential_id ++
            cred.holder ++
            cred.credential_type ++
            field(cred.issued_at) ++
            field(cred.expires_at)
        );

        var current: Bytes<32> = commitment;
        for (var i = 0; i < 16; i = i + 1) {
            if (proof_directions[i]) {
                current = hash(proof_path[i] ++ current);
            } else {
                current = hash(current ++ proof_path[i]);
            }
        }
        return current == credential_tree.root();
    }

    // ---- Holder-Privacy Verification ----

    circuit verify_holder_has_valid_credential(
        holder_id: Bytes<32>,
        credential_type: Bytes<16>,
        credential_id: Bytes<32>,
        proof_path: Vector<16, Bytes<32>>,
        proof_directions: Vector<16, Boolean>
    ): Boolean {
        if (!credential_exists[credential_id]) { return false; }
        let cred: Credential = credentials[credential_id];
        if (cred.holder != holder_id) { return false; }
        if (cred.credential_type != credential_type) { return false; }
        return verify_credential(credential_id, proof_path, proof_directions);
    }

    // ---- Utility ----

    circuit get_tree_root(): Bytes<32> {
        return credential_tree.root();
    }

    circuit get_credential_count(): Uint<32> {
        return credential_count;
    }

    circuit get_credential(credential_id: Bytes<32>): Credential {
        require(credential_exists[credential_id]);
        return credentials[credential_id];
    }

    circuit advance_time(new_time: Uint<64>, caller: Bytes<32>): Boolean {
        require(caller == admin);
        require(new_time > current_time);
        current_time = new_time;
        return true;
    }
}
