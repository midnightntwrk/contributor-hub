/**
 * Bilateral Private Escrow Example
 * 
 * Demonstrates Pattern 1: Two parties engage in a private transaction
 * where neither party's constraints (max/min price) are revealed.
 * 
 * The contract verifies ZK proofs that the agreed price falls within
 * both parties' private bounds.
 */

enum EscrowStatus { Open, Initiated, Completed, Cancelled }

contract PrivateEscrow {

    // ── Public State ──────────────────────────────────────
    public status: EscrowStatus;
    public escrowAmount: Coin<0>;
    public agreedPriceCommitment: Field;   // hash of agreed price
    public timeoutBlock: uint<64>;

    // ── Private State ─────────────────────────────────────

    // Buyer's private constraints
    private buyerState: {
        maxPrice: Field,
        depositNonce: Field,
        secret: Field
    };

    // Seller's private constraints
    private sellerState: {
        minPrice: Field,
        acceptNonce: Field,
        secret: Field
    };

    // ── Transitions ───────────────────────────────────────

    /**
     * Buyer initiates escrow by depositing funds.
     * The maxPrice is committed via a hash — never revealed on-chain.
     */
    transition initiate(
        maxPriceCommitment: Hash,
        deposit: Coin<0>,
        timeoutBlocks: uint<64>,
        buyerProof: Proof    // proves buyer knows preimage of commitment
    ) {
        assert(status == EscrowStatus.Open);
        assert(verify(buyerProof, maxPriceCommitment, "commitment_valid"));
        
        escrowAmount += deposit;
        agreedPriceCommitment = maxPriceCommitment;
        timeoutBlock = currentBlock() + timeoutBlocks;
        status = EscrowStatus.Initiated;
    }

    /**
     * Seller accepts the escrow with an agreed price.
     * Two ZK proofs are required:
     *   1. Buyer's proof: agreedPrice <= buyerState.maxPrice
     *   2. Seller's proof: agreedPrice >= sellerState.minPrice
     *
     * Neither maxPrice nor minPrice is ever exposed.
     */
    transition accept(
        agreedPrice: Field,
        buyerBoundProof: Proof,
        sellerBoundProof: Proof,
        sellerSignature: Signature
    ) {
        assert(status == EscrowStatus.Initiated);
        assert(currentBlock() < timeoutBlock);
        
        // Verify the agreed price is within buyer's private bounds
        assert(verify(
            buyerBoundProof,
            agreedPrice,
            "lte",           // agreedPrice <= maxPrice
            "buyer_bound"
        ));

        // Verify the agreed price is within seller's private bounds
        assert(verify(
            sellerBoundProof,
            agreedPrice,
            "gte",           // agreedPrice >= minPrice
            "seller_bound"
        ));

        // Store commitment to agreed price (not the price itself)
        agreedPriceCommitment = hash(agreedPrice);
        
        // Release escrow to seller
        transfer(escrowAmount, seller());
        status = EscrowStatus.Completed;
    }

    /**
     * Cancel escrow after timeout. Funds return to buyer.
     */
    transition cancel() {
        assert(status == EscrowStatus.Initiated);
        assert(currentBlock() >= timeoutBlock);
        
        transfer(escrowAmount, buyer());
        status = EscrowStatus.Cancelled;
    }
}
